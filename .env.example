# Public Supabase browser configuration. These VITE_* values are bundled into client code.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Client-side convenience gate only; not a server-side secret or database security control.
# Prefer Supabase Auth MFA and RLS for production authorization.
VITE_ADMIN_2FA_PIN=
